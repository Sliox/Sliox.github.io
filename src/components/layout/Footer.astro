---
import { SITE, THEME_CONFIG, SETTINGS } from "../../config";
import Icon from "../ui/Icon.astro";
import { withBase } from "../../utils/url";

const currentYear = new Date().getFullYear();
const showToggle = THEME_CONFIG.lightAndDark;
const showDevTools = import.meta.env.DEV || SETTINGS.addDevToolsInProduction;
const showRSS = SETTINGS.showRSSInFooter;
---

<footer class="footer">
    <div class="flex items-center gap-4">
        <span class="body-xs">&copy; {currentYear} {SITE.author}.</span>
    </div>
    <div class="flex items-center gap-4">
        <span class="body-xs hidden sm:inline-block"
            >Diseño: <a
                href="https://github.com/rubzip/academic-portfolio-astro/"
                target="_blank"
                rel="noopener noreferrer"
                class="link">Academic Portfolio Astro</a
            ></span
        >
        {
            showRSS && (
                <a
                    href={withBase("/rss.xml")}
                    aria-label="RSS"
                    title="RSS"
                    target="_blank"
                    rel="noreferrer"
                    class="btn-icon"
                >
                    <Icon name="RSS" size={16} />
                </a>
            )
        }
        <button
            type="button"
            data-ri-replay
            aria-label="Repetir animación de ensamblaje"
            title="Repetir animación de ensamblaje"
            class="btn-icon"
        >
            <Icon name="Replay" size={16} />
        </button>
        {
            showToggle && (
                <button
                    id="theme-toggle"
                    aria-label="Cambiar tema claro/oscuro" title="Cambiar tema"
                    class="btn-icon"
                >
                    <Icon name="Sun" size={16} class="hidden dark:block" />
                    <Icon name="Moon" size={16} class="block dark:hidden" />
                </button>
            )
        }
        {
            showDevTools && (
                <a
                    href={withBase("/dev-tools")}
                    aria-label="Developer Tools"
                    title="Developer Tools"
                    class="btn-icon"
                >
                    <Icon name="Settings" size={16} />
                </a>
            )
        }
    </div>
</footer>
