---
import { getCollection } from "astro:content";
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import CorreaVision from "../../components/demos/CorreaVision.astro";

if (PAGES.projects.isActive === false) {
    return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/404`);
}

export async function getStaticPaths() {
    if (PAGES.projects.isActive === false) return [];
    const projects = await getCollection("projects");
    return projects.map((project: any) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { id } = Astro.params;
const { project } = Astro.props;
const demo = project?.data?.demo;
---

<BaseDetail collection="projects" id={id}>
    {demo === "correa-3d" && <CorreaVision slot="demo" />}
</BaseDetail>
